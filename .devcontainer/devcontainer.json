{
  "name": "Loja Web IFTO",
  "image": "mcr.microsoft.com/devcontainers/universal:6-noble",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "installMaven": "true",
      "installGradle": "false"
    }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Loja Web - Tomcat",
      "onAutoForward": "openBrowser"
    }
  }
}
